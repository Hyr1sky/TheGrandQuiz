# LLM provider 配置样板——真实值只放 .env（已 gitignore），本文件仅示例、绝不含密钥。
# 两个命名角色，各一组 OpenAI 兼容端点配置：

# basic 角色（判卷等基础任务）——示例：deepseek
LLM_API_KEY=sk-your-deepseek-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_DISABLE_THINKING=false

# enrich 角色（出题富化等）——示例：qwen（DashScope OpenAI 兼容模式）
ENRICH_LLM_API_KEY=sk-your-qwen-key-here
ENRICH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ENRICH_LLM_MODEL=qwen-plus
ENRICH_LLM_TIMEOUT_SECONDS=60
ENRICH_LLM_DISABLE_THINKING=true

# 可选 Web Search：指向已有 SearXNG 服务；不配置则不注册 web_search 工具。
# GrandQuiz 不负责启动该服务，Docker 也不是基础安装要求。
SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT_SECONDS=10
