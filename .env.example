# LLM provider 配置样板——真实值只放 .env（已 gitignore），本文件仅示例、绝不含密钥。
# 推荐 Profile 模式：复制 model-profiles.example.toml 到仓库外，再填它的绝对路径。
# 指定后该文件是唯一的 endpoint/model/能力配置来源；.env 只保存其中 api_key_env 引用的密钥值。
# Web 模型下拉框读取 TOML 的 [profiles]，不会拿 API Key 自动扫描厂商模型目录。
# GRANDQUIZ_MODEL_CONFIG=/absolute/path/to/model-profiles.toml
# 样例的单默认 DeepSeek Profile 只需下方 LLM_API_KEY；启用可选 Qwen/Anthropic Profile 时再填写对应 Key。
# DASHSCOPE_MODEL_KEY=sk-your-qwen-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# 未设置 GRANDQUIZ_MODEL_CONFIG 时使用下方 legacy 兼容入口；默认只需一组 OpenAI-compatible 配置。

# 默认模型（所有调用；旧 basic/enrich 槽共用）——示例：deepseek
LLM_API_KEY=sk-your-deepseek-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_API_DIALECT=deepseek
LLM_THINKING_MODE=disabled
# 仅 thinking enabled 时可选：high / max
# LLM_REASONING_EFFORT=high
# 仅 OpenRouter BYOK 使用：把请求钉到指定 provider，并禁止回退到 OpenRouter 共享端点。
# LLM_ONLY_PROVIDER=deepseek

# 可选旧 enrich 槽覆盖（出题等）——示例：qwen（DashScope OpenAI 兼容模式）。
# 全部 ENRICH 字段缺失/空白时继承完整默认配置，不是失败后的自动 fallback。
# 启用任一 ENRICH 字段，就必须完整填写 API_KEY / BASE_URL / MODEL；不跨组拼接凭证。
# ENRICH_LLM_API_KEY=sk-your-qwen-key-here
# ENRICH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ENRICH_LLM_MODEL=qwen-plus
# ENRICH_LLM_TIMEOUT_SECONDS=60
# ENRICH_LLM_API_DIALECT=dashscope
# ENRICH_LLM_THINKING_MODE=disabled
# 仅 OpenRouter BYOK 使用：
# ENRICH_LLM_ONLY_PROVIDER=alibaba

# 可选 Web Search（任选其一）：Tavily 免费额度无需信用卡；不配置则不注册 web_search 工具。
TAVILY_API_KEY=tvly-your-key-here
TAVILY_TIMEOUT_SECONDS=10

# 自托管替代：指向已有 SearXNG，或使用 deploy/searxng 的最小单容器配置。
SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT_SECONDS=10

# 仅当 Tavily 与 SearXNG 同时配置时必填，防止静默切换供应商。
WEB_SEARCH_PROVIDER=tavily

# 可选语音答题（v0.5，百炼 DashScope 原生多模态接口）。不配置时 Web 隐藏语音入口。
DASHSCOPE_API_KEY=sk-your-dashscope-key-here
DASHSCOPE_WORKSPACE_ID=ws-your-workspace-id-here
DASHSCOPE_REGION=cn-beijing
ASR_MODEL=qwen-audio-3.0-asr-flash
# 首次运行的默认值；Web「设置 → 语音与材料词表」可热更新并持久化覆盖它。
ASR_ENABLE_HINTS=false
